# Copie para .env (ou exporte as variáveis) antes de rodar. Nenhum valor real deve ser versionado.
SECRET_KEY=
FLASK_DEBUG=false
HOST=127.0.0.1
PORT=5000
DATABASE_PATH=loja.db
APP_ENV=desenvolvimento
# Habilita POST /admin/reset-db (header X-Admin-Token). Vazio = endpoint sempre negado.
ADMIN_TOKEN=

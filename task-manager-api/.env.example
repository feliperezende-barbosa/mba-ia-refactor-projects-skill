# Copie para .env antes de rodar. Nenhum valor real deve ser versionado.
SECRET_KEY=
FLASK_DEBUG=false
HOST=127.0.0.1
PORT=5000
DATABASE_URL=sqlite:///tasks.db
TOKEN_MAX_AGE_SECONDS=28800
# SMTP opcional: sem SMTP_HOST os e-mails apenas são registrados em log
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
